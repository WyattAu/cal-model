  /begin MODULE engine "V8 engine ECU"

    /begin IF_DATA DCM
      {
        DCM { static { items { item { name "eng_load"; } } } }
      }
    /end IF_DATA

    /begin RECORD_LAYOUT RL_UWORD
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_UBYTE
      FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_UWORD_BLOCK
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
      NO_AXIS_PTS_X 1
      NO_AXIS_PTS_Y 1
    /end RECORD_LAYOUT

    /begin COMPU_METHOD rpm_lin "Engine speed, 0.25 rpm per count" LINEAR
      "%.2f" "1/min" COEFFS_LINEAR 0.25 0
    /end COMPU_METHOD

    /begin COMPU_METHOD load_lin "Relative load, 0.1 % per count, -10 % offset" LINEAR
      "%.2f" "%" COEFFS_LINEAR 0.1 -10
    /end COMPU_METHOD

    /begin COMPU_METHOD press_rat "Boost pressure, quadratic rational" RAT_FUNC
      "%.3f" "kPa" COEFFS 0.0001 0.5 0 0 0 1
    /end COMPU_METHOD

    /begin COMPU_METHOD torque_lin "Torque, reducible rational (0.5x + 100) / 2" RAT_FUNC
      "%.2f" "Nm" COEFFS 0 0.5 100 0 0 2
    /end COMPU_METHOD

    /begin COMPU_METHOD boost_tab "Boost target lookup (interpolated)" TABLE
      "%.2f" "kPa" COMPU_TAB_REF boost_curve_tab
    /end COMPU_METHOD

    /begin COMPU_METHOD gear_conv "Gear index lookup (stepped)" TABLE
      "%.0f" "-" COMPU_TAB_REF gear_vtab
    /end COMPU_METHOD

    /begin COMPU_METHOD identity_raw "Raw passthrough" IDENTICAL
      "%.0f" "-"
    /end COMPU_METHOD

    /begin COMPU_METHOD flag_ident "Boolean flag passthrough" IDENTICAL
      "%.0f" "-"
    /end COMPU_METHOD

    /begin COMPU_TAB boost_curve_tab "Boost target over engine speed" TAB_INTP
      DEFAULT_VALUE_NUMERIC 0 0
      0 0
      1000 45
      2000 78
      3000 105
      4000 128
      5000 142
      6000 150
    /end COMPU_TAB

    /begin COMPU_VTAB gear_vtab "Gear index" TAB_VERB
      DEFAULT_VALUE_NUMERIC 0 0
      0 0
      1 1
      2 2
      3 3
      4 4
    /end COMPU_VTAB

    /begin CHARACTERISTIC eng_load "Engine load request" VALUE 0x720100
      RL_UWORD 0 load_lin 0.0 100.0
      FORMAT "%.2f"
      ECU_ADDRESS 0x720100
    /end CHARACTERISTIC

    /begin CHARACTERISTIC eng_torque_max "Maximum engine torque" VALUE 0x720104
      RL_UWORD 0 torque_lin 50.0 700.0
      ECU_ADDRESS 0x720102
    /end CHARACTERISTIC

    /begin CHARACTERISTIC idle_target_rpm "Idle target speed" VALUE 0x720108
      RL_UWORD 10 rpm_lin 500.0 1200.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC boost_target "Boost pressure target" VALUE 0x72010C
      RL_UWORD 0 press_rat 0.0 250.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC rev_limit_cut "Rev limiter cut enabled" VALUE 0x720110
      RL_UBYTE 5 flag_ident 0.0 1.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC ecu_serial "ECU identification string" ASCII 0x700100
      RL_UBYTE 0 identity_raw 0.0 0.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC boost_curve "Boost target curve over speed" CURVE 0x721000
      RL_UWORD_BLOCK 0 boost_tab 0.0 250.0
