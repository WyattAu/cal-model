      /begin AXIS_DESCR rpm_axis "Engine speed" UWORD 0x729000
        NO_AXIS_PTS 8
        INPUT_QUANTITY engine_speed
      /end AXIS_DESCR
    /end CHARACTERISTIC

    /begin CHARACTERISTIC inj_map "Main injection quantity" MAP 0x722000
      RL_UWORD_BLOCK 0 load_lin 0.0 100.0
      EXTENDED_LIMITS 0.0 120.0
      /begin AXIS_DESCR load_axis "Relative load" UWORD 0x729800
        NO_AXIS_PTS 16
        INPUT_QUANTITY eng_load
      /end AXIS_DESCR
      /begin AXIS_DESCR rpm_axis "Engine speed" UWORD 0x729C00
        NO_AXIS_PTS 16
        INPUT_QUANTITY engine_speed
      /end AXIS_DESCR
    /end CHARACTERISTIC

    /begin CHARACTERISTIC knock_table "Knock threshold value block" VAL_BLK 0x723000
      RL_UWORD_BLOCK 0 boost_tab 0.0 250.0
    /end CHARACTERISTIC

    /begin MEASUREMENT engine_speed "Engine speed" UWORD
      rpm_lin 0.01 0.0 0.0 8000.0
      ECU_ADDRESS 0x320001
      FORMAT "%.0f"
    /end MEASUREMENT

    /begin MEASUREMENT coolant_temp "Coolant temperature" SBYTE
      load_lin 1.0 0.0 -40.0 120.0
      ECU_ADDRESS 0x320100
    /end MEASUREMENT

    /begin MEASUREMENT boost_actual "Measured boost pressure" UWORD
      press_rat 0.01 0.0 0.0 250.0
      ECU_ADDRESS 0x320200
    /end MEASUREMENT

    /begin FUNCTION torque_chain "Torque model outputs"
      DEF_CHARACTERISTIC eng_torque_max
      IN_MEASUREMENT engine_speed
      LOC_MEASUREMENT boost_actual
    /end FUNCTION

    /begin GROUP calibration_group "Engine adjustables"
      GROUP_CHARACTERISTIC eng_load eng_torque_max boost_target
    /end GROUP

  /end MODULE

  /begin MODULE transmission "Transmission ECU"

    /begin RECORD_LAYOUT RL_UWORD
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_UBYTE
      FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_UWORD_BLOCK
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin COMPU_METHOD ratio_lin "Gear ratio, 1e-4 per count" LINEAR
      "%.5f" "-" COEFFS_LINEAR 0.0001 0
    /end COMPU_METHOD

    /begin COMPU_METHOD shift_time_lin "Shift time, 0.5 ms per count, -20 ms offset" LINEAR
      "%.2f" "ms" COEFFS_LINEAR 0.5 -20
    /end COMPU_METHOD

    /begin COMPU_METHOD clutch_rat "Clutch force, quadratic rational" RAT_FUNC
      "%.3f" "N" COEFFS 0.0005 0.2 0 0 0 1
    /end COMPU_METHOD

    /begin COMPU_METHOD trq_lin "Line pressure, reducible rational x / 4" RAT_FUNC
      "%.2f" "kPa" COEFFS 0 1 0 0 0 4
    /end COMPU_METHOD

    /begin COMPU_METHOD gear_tab "Gear position lookup (interpolated)" TABLE
      "%.0f" "-" COMPU_TAB_REF gear_pos_tab
    /end COMPU_METHOD

    /begin COMPU_METHOD ratio_tab "Ratio index lookup (stepped)" TABLE
      "%.0f" "-" COMPU_TAB_REF ratio_vtab
    /end COMPU_METHOD

    /begin COMPU_METHOD raw_ident "Raw counter passthrough" IDENTICAL
      "%.0f" "-"
    /end COMPU_METHOD

    /begin COMPU_METHOD count_ident "Mode counter passthrough" IDENTICAL
      "%.0f" "-"
    /end COMPU_METHOD

    /begin COMPU_TAB gear_pos_tab "Gear position over input speed" TAB_INTP
      DEFAULT_VALUE_NUMERIC 0 0
      0 0
      10 1
      25 2
      45 3
    /end COMPU_TAB

    /begin COMPU_VTAB ratio_vtab "Ratio index" TAB_VERB
      DEFAULT_VALUE_NUMERIC 1 0
      1 0
      2 1
      3 2
      4 3
    /end COMPU_VTAB

    /begin CHARACTERISTIC primary_ratio "Primary gear ratio" VALUE 0x730100
      RL_UWORD 0 ratio_lin 0.0 3.5
    /end CHARACTERISTIC

    /begin CHARACTERISTIC shift_pressure "Line shift pressure" VALUE 0x730104
      RL_UWORD 0 trq_lin 0.0 100.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC shift_time_ms "Shift duration" VALUE 0x730108
      RL_UWORD 5 shift_time_lin -20.0 250.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC clutch_force "Clutch apply force" VALUE 0x73010C
      RL_UWORD 0 clutch_rat 0.0 200.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC gear_code "Selected gear code" VALUE 0x730110
      RL_UBYTE 0 gear_tab 0.0 6.0
    /end CHARACTERISTIC

    /begin CHARACTERISTIC shift_map "Shift-time map over load and speed" MAP 0x732000
      RL_UWORD_BLOCK 0 shift_time_lin -20.0 250.0
      /begin AXIS_DESCR load_axis "Relative load" UWORD 0x739800
        NO_AXIS_PTS 8
      /end AXIS_DESCR
    /end CHARACTERISTIC

    /begin MEASUREMENT turb_speed "Turbine speed" UWORD
      ratio_lin 0.01 0.0 0.0 3.5
      ECU_ADDRESS 0x330001
    /end MEASUREMENT

    /begin MEASUREMENT out_speed "Output shaft speed" UWORD
      raw_ident 0.1 0.0 0.0 6553.5
      ECU_ADDRESS 0x330100
    /end MEASUREMENT

  /end MODULE

/end PROJECT